config {
	concatenateJs = 1
	compressJs = 1
	moveJsFromHeaderToFooter = 1
	removeDefaultJS =
}

page.jsInline {
    10 = TEXT
    10.value (
      const header = document.getElementById('header');
      const logo = document.getElementById('logo');
      const menu = document.getElementById('menu');
      const hmbrgr = document.getElementById('hmbrgr');

      document.addEventListener('DOMContentLoaded', function() {
        const expandableTexts = document.querySelectorAll('.expandable-text');

        expandableTexts.forEach(container => {
          const shortTextSpan = container.querySelector('p > .short-text');
          const fullTextContainer = container.querySelector('.full-text'); // The <p> containing the full text span
          const expandLink = container.querySelector('.expand-link a');
          const collapseLink = container.querySelector('.collapse-link a');

          if (shortTextSpan && fullTextContainer && expandLink && collapseLink) {
            expandLink.addEventListener('click', function(event) {
              event.preventDefault();
              shortTextSpan.style.display = 'none';
              fullTextContainer.style.display = 'block';
            });

            collapseLink.addEventListener('click', function(event) {
              event.preventDefault();
              fullTextContainer.style.display = 'none';
              shortTextSpan.style.display = 'inline';
            });
          }
        });
      });
    )
}
# load jQuery
["{$microtemplate.jQuery}" == "1"]
  page.includeJSFooterlibs.jQuery = EXT:microtemplate/Resources/Public/JavaScript/Contrib/jQuery/jquery.min.js
  page.includeJSFooterlibs.jQuery.forceOnTop = 1
[END]

# load in all pages
	page.includeJSFooterlibs.all = EXT:microtemplate/Resources/Public/JavaScript/Page/all.js
	page.includeJSFooterlibs.forms = EXT:microtemplate/Resources/Public/JavaScript/Page/forms.js

# load in home page only
  [tree.pagelayout == "pagets__home"]
		page.includeJSFooterlibs.home = EXT:microtemplate/Resources/Public/JavaScript/Page/home.js
		page.includeJSFooterlibs.menus = EXT:microtemplate/Resources/Public/JavaScript/Page/menus.js
	[END]
